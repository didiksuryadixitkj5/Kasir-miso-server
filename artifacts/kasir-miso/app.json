{
  "expo": {
    "name": "Kasir Miso",
    "slug": "kasirwarung",
    "version": "7.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.kasirwarung.app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF6FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kasirwarung.app"
    },
    "android": {
      "package": "com.kasirwarung.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/kasir_miso_notification.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleClientIds": {
        "web": "553508307121-cj1jc7n5005r5e6bqh0gp9omeoucrdev.apps.googleusercontent.com",
        "android": "553508307121-uk04mtntjliikejh3dinbprgin3mk0a8.apps.googleusercontent.com",
        "ios": "553508307121-f0h23n5rj0jpmh5168cqt50umcj8dqid.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "e5f461a4-0000-4cd5-b4f2-f0296c732490"
      }
    },
    "owner": "ddksryd"
  }
}
